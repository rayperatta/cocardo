# Plantilla de configuración. No la edites: corre scripts/preparar.sh, que crea .env a partir de
# esta plantilla y genera las contraseñas. .env tiene secretos, así que git lo ignora.

# --- Versión de Postiz (la misma en tu computadora y en el VPS) ---
POSTIZ_VERSION=v2.25.1

# --- Dirección con la que abres Postiz en el navegador ---
# En tu computadora: http://localhost:4007
# En el VPS:         https://postiz.tudominio.com   (sin / al final)
POSTIZ_URL=http://localhost:4007

# --- Solo en el VPS ---
# COMPOSE_PROFILES=vps arranca Caddy en los puertos 80 y 443 con HTTPS automático.
# POSTIZ_DOMINIO es el mismo dominio de POSTIZ_URL, sin https://.
COMPOSE_PROFILES=
POSTIZ_DOMINIO=

# --- Secretos (los genera scripts/preparar.sh) ---
# No cambies las contraseñas de las bases de datos después del primer arranque: las bases ya
# quedaron creadas con ellas.
JWT_SECRET=
POSTGRES_PASSWORD=
TEMPORAL_DB_PASSWORD=

# Ponlo en true después de crear tu cuenta, para que nadie más pueda registrarse.
DISABLE_REGISTRATION=false

# Máximo de llamadas por hora para crear publicaciones por la API (la usan el agente y la CLI).
API_LIMIT=90

# --- Llaves de cada plataforma (README.md, sección "Conectar las plataformas") ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Facebook e Instagram (cuenta de Instagram unida a una página de Facebook) usan la misma app de Meta.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Instagram sin página de Facebook ("Instagram (Standalone)" en Postiz). Opcional.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# Opcional: funciones de IA dentro de Postiz (textos e imágenes). El agente no lo necesita.
OPENAI_API_KEY=
